<resources>
    <!-- Plain window theme; all real UI theming (colors, typography, dark mode)
         is handled by Compose Material3 in ui/theme/Theme.kt. Because minSdk
         is 31 we can use the platform Splash Screen attributes directly and
         skip the androidx.core:core-splashscreen dependency entirely. -->
    <style name="Theme.TimeTrace" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
